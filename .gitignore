# ========================================
# Graduate — Git Ignore
# ========================================

# Dependências Node.js
node_modules/

# Arquivos compilados
dist/
build/
coverage/

# Variáveis de ambiente
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Arquivos temporários
*.tmp
*.temp
*.swp
*.swo
*~

# Configurações locais de editores
.vscode/
.idea/

# Arquivos do sistema operacional
.DS_Store
Thumbs.db

# Cache
.cache/
.vite/
*.tsbuildinfo

# Bancos de dados locais
*.db
*.sqlite
*.sqlite3

# Backups e arquivos compactados
*.zip
*.tar
*.gz
*.bak

# Relatórios e dados privados
dados-reais/
backups/